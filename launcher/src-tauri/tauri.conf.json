{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lucent Launcher",
  "version": "0.1.2",
  "identifier": "io.github.mojunseo.lucentlauncher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Lucent Launcher",
        "width": 960,
        "height": 600,
        "minWidth": 820,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://mc-heads.net https://cdn.modrinth.com data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "Lucent Client launcher",
    "publisher": "mojunseo",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyMUZBMkJGNTA5Q0FCQzQKUldURXE1eFF2NklmNGt3QnZVL2hhUmxNWEt6OFVCeFdjWEhQWTdHc0FDaFRwajdEblhCUG5Jd3gK",
      "endpoints": [
        "https://github.com/mojunseo/Lucentclient/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
